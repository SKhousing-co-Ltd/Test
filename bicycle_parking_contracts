-- 駐輪場契約テーブルの作成
CREATE TABLE IF NOT EXISTS bicycle_parking_contracts (
    bicycle_parking_contract_id UUID DEFAULT gen_random_uuid() PRIMARY KEY, -- 駐輪場契約ID (uid)
    bicycle_parking_space_id UUID NOT NULL,                                  -- 駐輪場区画ID (FK)
    tenant_client_id UUID NOT NULL,                                          -- 借主取引先ID (FK)
    rent_amount NUMERIC(10, 0),                                              -- 賃料 (金額)
    deposit_amount NUMERIC(10, 0),                                           -- 敷金 (金額)
    contract_start_date DATE,                                                -- 契約開始日
    
    -- 外部キー制約 (関連テーブルとの紐づけ)
    CONSTRAINT fk_bicycle_parking_spaces
        FOREIGN KEY (bicycle_parking_space_id) 
        REFERENCES bicycle_parking_spaces_master (bicycle_parking_space_id)
        ON DELETE RESTRICT,
        
    CONSTRAINT fk_tenant_clients
        FOREIGN KEY (tenant_client_id) 
        REFERENCES clients_table (client_id)
        ON DELETE RESTRICT
);
